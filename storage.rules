rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == "YOUR_ADMIN_EMAIL";
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 8 * 1024 * 1024;
    }
  }
}
